# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# OpenRouter
OPENROUTER_API_KEY=sk-or-................................
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-super-vl

# Embedding model (fixed for now)
EMBED_MODEL_ID=nvidia/nemotron-3-embed-1b:free

# Database
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme

# MinIO
MINIO_ROOT_USER=rag
MINIO_ROOT_PASSWORD=changeme

# JWT
JWT_SECRET=changeme-please-replace-with-a-strong-secret
JWT_ALGORITHM=HS256

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=company_knowledge

# Redis
REDIS_URL=redis://rag-redis:6379
